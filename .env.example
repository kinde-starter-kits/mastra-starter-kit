# ---------------------------------------------------------------------------
# Copy to .env and fill in. `.env` is gitignored.
#
#   cp .env.example .env
#
# Two processes read this file: the Mastra server (server-side vars) and the
# Vite frontend (VITE_-prefixed vars only — Vite refuses to expose anything
# else to the browser, which is exactly what we want).
# ---------------------------------------------------------------------------


# --- Mastra server: verifying Kinde tokens ---------------------------------

# Your Kinde tenant URL. The provider derives the JWKS endpoint and the
# expected token issuer from this. Must include https://.
KINDE_DOMAIN=https://yourapp.kinde.com

# The API audience registered in Kinde (Settings -> APIs).
# Optional, but recommended: it is what makes Kinde treat the token as an API
# token for your backend. Leave BLANK until you have registered an API and
# authorized your application to use it — a default Kinde token has an empty
# `aud`, so setting this too early rejects every token.
KINDE_AUDIENCE=

# Optional. Comma-separated Kinde organization codes allowed to use this app.
# When set, tokens from any other organization are rejected at the server
# boundary before reaching an agent. Leave blank to allow all organizations.
KINDE_ALLOWED_ORG_CODES=


# --- Mastra server: storage and model --------------------------------------

# LibSQL. Leave BLANK to use `mastra.db` at the project root — the path is
# resolved from the project root, not the working directory, so `mastra dev`,
# `npm test` and a production start all agree on one file.
#
# Set it to override: an absolute `file:/abs/path/mastra.db`, or a hosted
# Turso URL (`libsql://...`). A relative `file:./mastra.db` is resolved against
# whatever directory the process happens to start in, so avoid it.
DATABASE_URL=

# There is deliberately NO OpenAI key here.
#
# Model access is strictly bring-your-own-key: each user adds their own key in
# the application, it is sent as a request header, and the server reads it for
# that request only. The server never reads an OpenAI key from its environment,
# so setting one here would have no effect.

# Auth token for a hosted LibSQL database. Leave BLANK for a local `file:`
# database, which needs no credential. Turso requires it.
DATABASE_AUTH_TOKEN=

# Optional. Set to `seeded` to plan from the small activity fixtures bundled
# with the repository instead of discovering real places. The test suite sets
# this itself so it can run offline and deterministically. Leave BLANK
# everywhere else, including production, so discovery runs for real.
ACTIVITY_SOURCE=

# Origin(s) allowed to call the Mastra server from a browser. Comma-separated.
# In production this must contain the deployed frontend origin.
APP_ORIGIN=http://localhost:5173


# --- Frontend (Vite) -------------------------------------------------------
#
# NOTE: there is deliberately NO client secret here. This frontend is a public
# SPA using the Authorization Code + PKCE flow, which is the correct Kinde flow
# for browser apps. A client secret cannot be kept secret in a browser bundle,
# so Kinde does not use one for this application type. If you switch the
# frontend to a server-rendered framework, add KINDE_CLIENT_SECRET there and
# keep it server-side only.

# Same tenant URL as KINDE_DOMAIN above.
VITE_KINDE_DOMAIN=https://yourapp.kinde.com

# The Client ID of your Kinde application (type: Single Page Application).
VITE_KINDE_CLIENT_ID=

# Must match the callback/logout URLs configured on the Kinde application.
VITE_KINDE_REDIRECT_URI=http://localhost:5173
VITE_KINDE_LOGOUT_URI=http://localhost:5173

# Must match KINDE_AUDIENCE above. Requests an access token for your API so
# the token carries the claims the Mastra server checks. Leave blank if you
# left KINDE_AUDIENCE blank.
VITE_KINDE_AUDIENCE=

# Where the Mastra server is listening. Local development uses the value below.
# A deployment must set this to the deployed backend origin instead.
VITE_MASTRA_URL=http://localhost:4111
