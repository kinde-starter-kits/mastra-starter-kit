{
  "name": "mastra-starter-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Plan My Day — a Mastra + Kinde starter kit demonstrating authenticated, organization-scoped, permission-gated AI agents",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:mastra & npm run dev:app",
    "dev:mastra": "mastra dev --dir src/mastra",
    "dev:app": "vite",
    "build": "mastra build --dir src/mastra && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "license": "MIT",
  "dependencies": {
    "@kinde-oss/kinde-auth-react": "^5.13.0",
    "@kinde-oss/mastra-auth-kinde": "github:kinde-oss/mastra-auth-kinde#move-provider-to-kinde-oss",
    "@libsql/client": "0.17.4",
    "@mastra/core": "^1.60.0",
    "@mastra/libsql": "^1.21.0",
    "@mastra/memory": "^1.27.0",
    "hono": "^4.12.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.6.0",
    "jose": "^6.2.1",
    "mastra": "^1.25.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.2.2",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
